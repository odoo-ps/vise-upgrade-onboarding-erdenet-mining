<?xml version="1.0"?>
<odoo>
    <record id="estate_property_offer_view_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.view.tree</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <tree editable="bottom" decoration-success="status == 'accepted'" decoration-danger="status == 'refused'">
                <field name="partner_id" />
                <field name="property_type_id"/>
                <field name="price" />
                <button name="action_offer_accept" string="Mark as Accepted" type="object" icon="fa-check" attrs="{'invisible': [('status', '!=', False)]}"/>
                <button name="action_offer_refuse" string="Mark as Refused"  type="object" icon="fa-xmark" attrs="{'invisible': [('status', '!=', False)]}"/>
                <field name="validity" />
                <field name="date_deadline" />
                <field name="is_expired" invisible="1"/>
                <field name="status" invisible="1"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.view.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id" />
                        <field name="price" />
                        <field name="status" />
                        <field name="validity" />
                        <field name="date_deadline" />
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
